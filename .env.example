# Thermal Test Analyzer — server environment variables.
# Copy this file to .env (in the repo root or the server/ directory) and adjust.
# All values are optional; sensible defaults are applied when unset.

# HTTP port for the API server.
PORT=4000

# Active AI provider for run/comparison summaries.
# One of: auto | openai | anthropic | openrouter | ollama | mock
#   auto       -> OpenAI if its key is set, else Anthropic, else OpenRouter, else Mock
#   openrouter -> OpenRouter (OpenAI-compatible) cloud API
#   ollama     -> local Ollama server (air-gapped friendly, no key)
#   mock       -> offline deterministic summarizer (no key, always available)
AI_PROVIDER=auto

# --- OpenAI (cloud) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (cloud) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- OpenRouter (cloud, OpenAI-compatible) ---
# Model uses OpenRouter's "vendor/model" slug, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Ollama (local / air-gapped) ---
# Base URL of the local Ollama server and the model to use.
# Pull the model first on the host running Ollama: `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
